---
import MainLayout from "../layouts/MainLayout.astro";
import ProjectsGrid from "../components/ProjectsGrid.astro";

// Карточки (визуал) + их данные (named export `project`)
import Project1, { project as project1 } from "../projects/cards/project1.astro";
import Project11,  { project as project11 }  from "../projects/cards/project11.astro";
import Project12,  { project as project12 }  from "../projects/cards/project12.astro";
import Project16,  { project as project16 }  from "../projects/cards/project16.astro";
import Project17,  { project as project17 }  from "../projects/cards/project17.astro";

// Public set: named projects require written attribution approval before inclusion.
const items = [
  { Comp: project11,  data: project11 },
  { Comp: project12,  data: project12 },
  { Comp: project1, data: project1 },
  { Comp: project16, data: project16 },
  { Comp: project17, data: project17 }
];
---

<MainLayout
  title="Selected Work — Veinspire Games"
  description="Selected anonymized Unreal Engine 5 delivery scopes and internal R&D from Veinspire Games."
>
  <ProjectsGrid items={items} title="Selected work" />
</MainLayout>
