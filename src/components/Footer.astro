---
import s from "../styles/footer.module.scss";

const year = new Date().getFullYear();
---
<footer id="site-footer" class={s.footer} aria-label="Site footer">
  <div class={`container ${s.grid}`}>
    <!-- Верхняя полоса -->
    <div class={s.colLeft}>
      <p class={s.kicker}>Core team based in Batumi, Georgia</p>
      <p class={s.legal}>
        Veinspire Games is operated by Individual Entrepreneur Petr Petrov · Georgia · ID 306493149
      </p>
      <nav class={s.policies} aria-label="Policies">
        <a class={s.link} href="/privacy">Privacy Notice</a>
      </nav>
    </div>

    <div class={s.badgeWrap}>
      <a
        class={s.directoryBadge}
        href="https://www.gamedevoutsourcing.com/company/veinspire-games?ref=badge"
        target="_blank"
        rel="noopener"
      >
        <svg
          class={s.badgeArtwork}
          xmlns="http://www.w3.org/2000/svg"
          width="341"
          height="64"
          viewBox="0 0 341 64"
          role="img"
          aria-label="Veinspire Games claims and maintains its own listing on Game Dev Outsourcing (2026). Verified means the studio runs this listing, not that its work has been audited."
        >
          <title>Veinspire Games claims and maintains its own listing on Game Dev Outsourcing (2026). Verified means the studio runs this listing, not that its work has been audited.</title>
          <defs>
            <linearGradient id="gdo-verified-panel" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#064e3b"></stop>
              <stop offset="1" stop-color="#022c22"></stop>
            </linearGradient>
            <linearGradient id="gdo-verified-shield" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#6ee7b7"></stop>
              <stop offset="1" stop-color="#10b981"></stop>
            </linearGradient>
          </defs>
          <rect x="0.5" y="0.5" width="340" height="63" rx="10" fill="url(#gdo-verified-panel)" stroke="#34d399" stroke-opacity="0.7"></rect>
          <path d="M14 1.5 H327" stroke="#a7f3d0" stroke-opacity="0.3" stroke-width="1" stroke-linecap="round"></path>
          <path d="M36 17 L48 22 L48 33 Q48 42 36 45 Q24 42 24 33 L24 22 Z" fill="url(#gdo-verified-shield)"></path>
          <path d="M30.6 31 L34.6 35.2 L41.8 26.6" fill="none" stroke="#064e3b" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
          <text x="68" y="29" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif" font-size="15" font-weight="700" fill="#d1fae5">Verified listing</text>
          <text x="68" y="46" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif" font-size="11" font-weight="500" fill="#6ee7b7" letter-spacing="0.2">Claimed by the studio · Game Dev Outsourcing</text>
        </svg>
        <span class={s.badgeCaption}>
          <strong>Veinspire Games</strong> claims and maintains its listing on <strong>Game Dev Outsourcing</strong> (2026)
        </span>
      </a>
    </div>

    <div class={s.colRight} aria-label="Social links">
      <a class={s.social}
        href="mailto:contact@veinspire-games.com?subject=Hello%20Veinspire%20Games" aria-label="Email">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 2v.01L12 12 4 6.01V6h16zM4 18V8.24l7.4 5.18a1 1 0 001.2 0L20 8.24V18H4z"/>
        </svg>
      </a>  
      
      <a class={s.social} href="https://www.reddit.com/user/VeinspireGames/" target="_blank" rel="noopener" aria-label="Reddit">
        <!-- Reddit -->
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M22 12.3c0-1.15-.94-2.09-2.09-2.09-.56 0-1.07.22-1.44.58-1.42-.88-3.32-1.45-5.46-1.52l.93-4.38 3.05.65c.05.78.68 1.4 1.47 1.4.81 0 1.47-.66 1.47-1.47S19.28 2.94 18.47 2.94c-.56 0-1.05.32-1.29.78l-3.58-.77c-.25-.06-.5.11-.56.36l-1.05 4.95c-2.19.06-4.16.64-5.6 1.54-.36-.38-.87-.61-1.44-.61C2.94 9.94 2 10.88 2 12.03c0 .74.38 1.39.95 1.76-.04.21-.06.43-.06.65 0 3 3.58 5.43 8 5.43s8-2.43 8-5.43c0-.22-.02-.44-.06-.65.57-.37.95-1.02.95-1.76zM8.97 14.13c0-.81.66-1.47 1.47-1.47s1.47.66 1.47 1.47-.66 1.47-1.47 1.47-1.47-.66-1.47-1.47zm8.09 2.56c-.95.95-2.85 1.59-4.99 1.59s-4.04-.64-4.99-1.59a.5.5 0 11.71-.71c.77.78 2.42 1.3 4.28 1.3 1.87 0 3.51-.52 4.28-1.3a.5.5 0 11.71.71zM12.56 12.66c0-.81.66-1.47 1.47-1.47s1.47.66 1.47 1.47-.66 1.47-1.47 1.47-1.47-.66-1.47-1.47z"/>
        </svg>
      </a>
      <a class={s.social} href="https://www.linkedin.com/company/veinspire-games/" target="_blank" rel="noopener" aria-label="LinkedIn">
        <!-- LinkedIn -->
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M4.98 3.5C4.98 4.88 3.86 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 5 2.12 5 3.5zM.5 8h4v12h-4V8zm7.5 0h3.8v1.9h.06c.53-.9 1.83-1.9 3.77-1.9 4.03 0 4.77 2.3 4.77 5.3V20h-4v-4.7c0-1.6-.03-3.6-2.56-3.6-2.56 0-2.95 1.7-2.95 3.5V20h-4V8z"/>
        </svg>
      </a>
      <a class={s.social} href="https://discord.com/invite/yvBXaeK7Jr" target="_blank" rel="noopener" aria-label="Discord">
        <!-- Discord -->
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M20.3 4.37A18.6 18.6 0 0015.86 3l-.22.44a16 16 0 00-7.3 0L8.12 3C6.4 3.37 4.76 4 3.27 4.87 1.26 8.02.63 11.05.86 14.03c2.02 1.5 4.07 2.42 6.16 2.75l.8-1.67c-.45-.17-.88-.37-1.29-.6.11-.08.22-.16.32-.25 2.48 1.15 5.18 1.15 7.66 0 .11.08.22.17.32.25-.41.24-.84.44-1.29.6l.8 1.67c2.09-.33 4.14-1.25 6.16-2.75.27-3.46-.55-6.49-1.9-9.66zM8.95 12.86c-.79 0-1.43-.73-1.43-1.64 0-.9.64-1.64 1.43-1.64.79 0 1.43.74 1.43 1.64 0 .91-.64 1.64-1.43 1.64zm6.1 0c-.79 0-1.43-.73-1.43-1.64 0-.9.64-1.64 1.43-1.64s1.43.74 1.43 1.64c0 .91-.64 1.64-1.43 1.64z"/>
        </svg>
      </a>
    </div>

    <!-- Нижняя полоса -->
    <div class={s.colFull}>
      <p>© {year} Veinspire Games. All Rights Reserved.</p>
      <p class={s.disclaimer}>
        All company names, brand names, trademarks, logos, illustrations, videos and any other intellectual property
        published on this website are the property of their respective owners.
      </p>
    </div>
  </div>
</footer>
