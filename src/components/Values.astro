---
import s from "../styles/values.module.scss";

const items = [
  {
    title: "Defined ownership",
    text:
      "Each engagement starts with a clear scope, named owners, dependencies, acceptance criteria, and delivery checkpoints.",
  },
  {
    title: "Founder-led delivery",
    text:
      "The founder remains directly involved in scoping, planning, stakeholder communication, delivery risk, and milestone control.",
  },
  {
    title: "Client workflow",
    text:
      "We work inside the client's production process and align with its repositories, task tracking, review cadence, and technical constraints.",
  },
  {
    title: "Scope-matched team",
    text:
      "A compact core team assembles a specialist delivery pod for the approved scope rather than selling an oversized bench.",
  },
  {
    title: "Verifiable work",
    text:
      "We describe contributions at the level we can support and separate studio delivery from the prior experience of individual team members.",
  },
  {
    title: "Practical R&D",
    text:
      "We develop internal prototypes, validation concepts, and reusable workflows to reduce repetitive production work.",
  },
];
---

<section class={s.wrap} aria-label="About values grid">
  <div class="container">
    {/* верхняя красная разделительная линия, как на рефе */}
    <div class={s.topRule} aria-hidden="true"></div>

    <div class={s.grid}>
      {items.map(({ title, text }, i) => (
        <article class={s.card}>
          <span class={s.dot} aria-hidden="true"></span>
          <h3 class={s.title}>{title}</h3>
          <p class={s.desc}>{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
